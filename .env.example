# Telegram Bot Token (Get this from BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Comma-separated list of Admin Telegram IDs
ADMIN_IDS=7363908717,123456789

# Neon PostgreSQL Database URI
# Ensure this uses the postgresql+asyncpg:// scheme, or standard postgresql://
DATABASE_URL=postgresql+asyncpg://user:pass@host/dbname?ssl=require

# Optional HuggingFace Dataset Path (defaults to hf://datasets/WipeX00/scrappeddata)
# ICMR_HF_INDEX_BASE=hf://datasets/WipeX00/scrappeddata
# TRUECALLER_HF_INDEX_BASE=hf://datasets/eKaiva/tirucaller
# INDDATA_HF_INDEX_BASE=hf://datasets/eKaiva/Inddatainonefile

# Logging Level
LOG_LEVEL=INFO

# MotherDuck Cloud Token
MOTHERDUCK_TOKEN=YOUR_MOTHERDUCK_TOKEN_HERE
